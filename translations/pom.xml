<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.wsb</groupId>
		<artifactId>animaladoption-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<!--
		Translations module (i18n). A library (jar) providing:
		  - key-value translation files (.properties) split into bundles by application area,
		  - the TranslationService interface and its implementation based on Spring MessageSource,
		  - Spring Boot auto-configuration (MessageSource, choosing and switching the language).
		An application using the module only needs to add it as a dependency.
	-->
	<artifactId>animaladoption-translations</artifactId>
	<packaging>jar</packaging>
	<name>animal-adoption-translations</name>
	<description>Translations module (i18n) of the animal adoption portal</description>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-autoconfigure</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
