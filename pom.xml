<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<!--
		Projekt nadrzędny (agregator). Nie zawiera kodu - spina moduły:
		  - translations : osobny projekt z tłumaczeniami (i18n) i serwisem TranslationService
		  - domain       : warstwa danych - encje JPA, enumy, repozytoria, wyjątki domenowe
		  - core         : logika biznesowa - serwisy, DTO, zdarzenia i kolejki RabbitMQ
		  - web          : aplikacja webowa (portal Łapka) - kontrolery, widoki, konfiguracja, klasa startowa

		Zależności między modułami idą tylko w jedną stronę:  web -> core -> domain
		Maven pilnuje tego podczas kompilacji - np. serwis z modułu core nie może użyć kontrolera z web,
		bo core nie ma modułu web w swoich zależnościach.
	-->
	<groupId>com.wsb</groupId>
	<artifactId>animaladoption-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>animal-adoption-parent</name>
	<description>Portal do adopcji zwierząt - projekt nadrzędny</description>

	<modules>
		<module>translations</module>
		<module>domain</module>
		<module>core</module>
		<module>web</module>
	</modules>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.wsb</groupId>
				<artifactId>animaladoption-translations</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.wsb</groupId>
				<artifactId>animaladoption-domain</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.wsb</groupId>
				<artifactId>animaladoption-core</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
