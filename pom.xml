<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<!--
		Parent project (aggregator). It contains no code - it ties the modules together:
		  - translations : separate project with translations (i18n) and the TranslationService
		  - domain       : data layer - JPA entities, enums, repositories, domain exceptions
		  - core         : business logic - services, DTOs, RabbitMQ events and queues
		  - web          : web application (Łapka portal) - controllers, views, configuration, main class

		Dependencies between modules go in one direction only:  web -> core -> domain
		Maven enforces this at compile time - e.g. a service from the core module cannot use a controller from web,
		because core does not have the web module in its dependencies.
	-->
	<groupId>com.wsb</groupId>
	<artifactId>animaladoption-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>animal-adoption-parent</name>
	<description>Animal adoption portal - parent project</description>

	<modules>
		<module>translations</module>
		<module>domain</module>
		<module>core</module>
		<module>web</module>
	</modules>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.wsb</groupId>
				<artifactId>animaladoption-translations</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.wsb</groupId>
				<artifactId>animaladoption-domain</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.wsb</groupId>
				<artifactId>animaladoption-core</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
