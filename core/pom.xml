<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.wsb</groupId>
		<artifactId>animaladoption-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<!--
		Business logic module. A library (jar) containing:
		  - service interfaces and their implementations (service, service.impl),
		  - DTO objects passed between the view and the services,
		  - RabbitMQ events and queue consumers (event, listener) and the queue configuration.
		Depends on the domain module (entities, repositories) and translations (email messages).
		It knows nothing about controllers or views - those live in the web module.
	-->
	<artifactId>animaladoption-core</artifactId>
	<packaging>jar</packaging>
	<name>animal-adoption-core</name>
	<description>Business logic of the animal adoption portal</description>

	<dependencies>
		<dependency>
			<groupId>com.wsb</groupId>
			<artifactId>animaladoption-domain</artifactId>
		</dependency>
		<dependency>
			<groupId>com.wsb</groupId>
			<artifactId>animaladoption-translations</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Spring Security core only (UserDetailsService, PasswordEncoder) - without web filters -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-core</artifactId>
		</dependency>
		<!-- Only for the MultipartFile type (uploaded files in DTOs and FileStorageService) - without Spring MVC -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
