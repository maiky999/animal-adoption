<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.wsb</groupId>
		<artifactId>animaladoption-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<!--
		Moduł logiki biznesowej. Biblioteka (jar) zawierająca:
		  - interfejsy serwisów i ich implementacje (service, service.impl),
		  - obiekty DTO przekazywane między widokiem a serwisami,
		  - zdarzenia i odbiorców kolejek RabbitMQ (event, listener) oraz konfigurację kolejek.
		Zależy od modułu domain (encje, repozytoria) i translations (komunikaty e-mail).
		Nie zna kontrolerów ani widoków - te są w module web.
	-->
	<artifactId>animaladoption-core</artifactId>
	<packaging>jar</packaging>
	<name>animal-adoption-core</name>
	<description>Logika biznesowa portalu do adopcji zwierząt</description>

	<dependencies>
		<dependency>
			<groupId>com.wsb</groupId>
			<artifactId>animaladoption-domain</artifactId>
		</dependency>
		<dependency>
			<groupId>com.wsb</groupId>
			<artifactId>animaladoption-translations</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Tylko rdzeń Spring Security (UserDetailsService, PasswordEncoder) - bez filtrów webowych -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-core</artifactId>
		</dependency>
		<!-- Tylko dla typu MultipartFile (przesyłane pliki w DTO i FileStorageService) - bez Spring MVC -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
