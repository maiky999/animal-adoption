# ==========================================
# KONFIGURACJA SERWERA (VPS) - ŁAPKA
# Na serwerze skopiuj ten plik jako ".env":   cp .env.production.example .env
# i uzupełnij wszystkie wartości. Plik .env nie trafia do repozytorium (.gitignore).
#
# Losowe wartości najprościej wygenerować na serwerze poleceniem:   openssl rand -base64 32
# Nie używaj znaku "$" w wartościach - Docker Compose traktuje go jak odwołanie do zmiennej.
# ==========================================

# Publiczny adres strony, BEZ "https://" i bez ukośnika na końcu.
# Własna domena (rekord A wskazujący na IP serwera), np.:  lapka.example.pl
# albo bez domeny - darmowy adres sslip.io z IP serwera zapisanym z myślnikami, np. dla 203.0.113.10:
#   203-0-113-10.sslip.io
DOMAIN=

# Baza danych (SQL Server). Hasło musi mieć min. 8 znaków i zawierać dużą literę, małą literę,
# cyfrę i znak specjalny - inaczej SQL Server nie wystartuje. Np. wynik openssl + "Aa1!" na końcu.
DB_NAME=animaladoption
DB_PASSWORD=

# Poczta - konto Gmail z włączoną weryfikacją dwuetapową i "hasłem aplikacji"
# (Konto Google -> Bezpieczeństwo -> Hasła do aplikacji). Zwykłe hasło do Gmaila nie zadziała.
MAIL_USERNAME=
MAIL_PASSWORD=

# RabbitMQ (dostępny tylko wewnątrz serwera)
RABBITMQ_USER=lapka
RABBITMQ_PASSWORD=

# Klucz ciasteczka "Zapamiętaj mnie"
REMEMBER_ME_KEY=

# Klucz szyfrowania danych w bazie (AES-256/GCM).
# UWAGA: zachowaj go w bezpiecznym miejscu - po jego zmianie lub utracie zaszyfrowane dane
# (telefony, wiadomości czatu) będą nie do odczytania.
CRYPTO_KEY=

# Pierwsze konto administratora - zakładane przy starcie tylko, gdy w bazie nie ma żadnego administratora.
# Hasło: co najmniej 12 znaków. Po pierwszym uruchomieniu obie zmienne można usunąć.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
