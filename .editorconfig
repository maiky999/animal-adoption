# Wspólne ustawienia edytora dla całego zespołu (IntelliJ IDEA, VS Code i inne obsługują EditorConfig).
# https://editorconfig.org
root = true

[*]
charset = utf-8

# Pliki tłumaczeń są zapisane w UTF-8 (moduł translations czyta je jako UTF-8).
# Bez tego IntelliJ domyślnie otwiera .properties jako ISO-8859-1 i psuje polskie znaki.
[*.properties]
charset = utf-8
